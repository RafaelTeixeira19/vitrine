anciens Majors tombées sous 25 % de leur prix","s":"sur 48 étudiées (prix des mois 4 à 12)"},{"v":"100 %","k":"remontées à 2 fois leur creux ou plus","s":"1 sur 1 aujourd'hui"},{"v":"100 %","k":"remontées à 5 fois leur creux ou plus","s":"1 sur 1"},{"v":"×357,1","k":"multiple médian depuis le creux","s":"9,7 ans en médiane depuis le creux"},{"v":"+2323 %","k":"rendement médian, Majors 2014 à 2019","s":"depuis les mois 4 à 12, 33 sur 33 en hausse"},{"v":"+1 %","k":"rendement médian, Majors 2020 à 2023","s":"8 sur 15 en hausse"},{"v":"+1361 %","k":"rendement médian, capsules Legends","s":"anciens Majors, 16 sur 19 en hausse"},{"v":"+2545 %","k":"rendement médian, capsules Challengers","s":"anciens Majors, 12 sur 14 en hausse"},{"v":"+46 %","k":"rendement médian, capsules Contenders","s":"anciens Majors, 3 sur 5 en hausse"}],"rA":{"n":1,"of":48,"x2":1,"x5":1,"down":0,"mult":357.1025656010753,"years_up":0.3333333333333333,"years_since":9.666666666666666},"pre":{"n":33,"ret":23.226650374408624,"up":33},"post":{"n":15,"ret":0.008550573514077175,"up":8},"tiers":{"Legends":{"n":19,"ret":13.611634206113763,"up":16},"Challengers":{"n":14,"ret":25.44885734045676,"up":12},"Contenders":{"n":5,"ret":0.46486259702118704,"up":3}}}}